---
// Web3Forms public Access Key. Replace the placeholder below with your own key
// (https://web3forms.com). The key is public by design and linked to your verified email.
const WEB3FORMS_ACCESS_KEY = "a8591049-9ff4-4958-8d22-3540e1ba7cd8";
---

<section class="contact" id="contact">
    <h2 class="contact-heading">Let's collaborate.</h2>
    <p class="contact-body">
        If you have a great idea or an exciting project, don't hesitate to
        contact me!
    </p>
    <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
        id="contact-form"
    >
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New message from GT Geosolutions website" />
        <input type="hidden" name="from_name" value="GT Geosolutions Website" />
        <!-- Honeypot: hidden from people, bots tend to fill it in -->
        <input
            type="checkbox"
            name="botcheck"
            class="contact-honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
        />
        <div class="contact-form-section">
            <label for="fullname" class="contact-form-label">Full Name</label>
            <input
                class="contact-form-input"
                type="text"
                name="fullname"
                id="fullname"
                placeholder="e.j Giovanni Giorgio"
                autocomplete="name"
                required
            />
        </div>
        <div class="contact-form-section">
            <label for="email" class="contact-form-label">Email</label>
            <input
                class="contact-form-input"
                type="email"
                name="email"
                id="email"
                placeholder="e.j example@mail.com"
                autocomplete="email"
                required
            />
        </div>
        <div class="contact-form-section">
            <label for="message" class="contact-form-label">Message</label>
            <textarea
                class="contact-form-input"
                name="message"
                id="message"
                placeholder="e.j Hi there!..."
                required></textarea>
        </div>
        <button type="submit" class="contact-form-btn">Send Message</button>
        <p class="contact-form-status" id="contact-form-status" role="status" aria-live="polite"></p>
    </form>
    <footer class="contact-footer">
        <p class="contact-copy">© 2025 Gil Thompson All rights reserved.</p>
        <ul class="contact-social">
            <li class="contact-link">
                <a href="https://github.com/GilThompson" aria-label="GitHub">
                    <i class="ri-github-fill"></i>
                </a>
            </li>
            <li class="contact-link">
                <a href="https://www.linkedin.com/in/gil-thompson" aria-label="LinkedIn">
                    <i class="ri-linkedin-fill"></i>
                </a>
            </li>
            <li class="contact-link">
                <a href="https://wa.me/524442428361?text=Hello%2C%20I%20am%20interested%20in%20your%20geospatial%20services."
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp">
                    <i class="ri-whatsapp-fill"></i>
                </a>
            </li>
            <li class="contact-link">
                <a href="#" aria-label="Twitter X">
                    <i class="ri-twitter-x-fill"></i>
                </a>
            </li>
        </ul>
    </footer>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const statusEl = document.getElementById("contact-form-status") as HTMLElement | null;

    if (form && statusEl) {
        const button = form.querySelector<HTMLButtonElement>(".contact-form-btn")!;
        const defaultLabel = button.textContent ?? "Send Message";
        let isSending = false;

        function setStatus(message: string, type: "success" | "error" | "") {
            statusEl!.textContent = message;
            statusEl!.className = "contact-form-status" + (type ? ` ${type}` : "");
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (isSending) return;

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            isSending = true;
            button.disabled = true;
            button.textContent = "Sending...";
            setStatus("", "");

            try {
                const data = Object.fromEntries(new FormData(form).entries());
                // Web3Forms expects "name"; keep the visible field id as "fullname"
                data.name = data.fullname;

                const response = await fetch(form.action, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json",
                    },
                    body: JSON.stringify(data),
                });

                const result = await response.json().catch(() => ({}));

                if (response.ok && result.success) {
                    form.reset();
                    setStatus("Thank you! Your message was sent successfully. I'll get back to you soon.", "success");
                } else {
                    setStatus(
                        result.message
                            ? `The message could not be sent: ${result.message}`
                            : "The message could not be sent. Please try again in a moment.",
                        "error",
                    );
                }
            } catch {
                setStatus(
                    "Network error. Please check your connection and try again.",
                    "error",
                );
            } finally {
                isSending = false;
                button.disabled = false;
                button.textContent = defaultLabel;
            }
        });
    }
</script>
